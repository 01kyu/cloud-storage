{
  "name": "cloud-storage",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && npm run lint:e2e",
    "lint:e2e": "eslint e2e playwright.config.ts",
    "typecheck": "turbo run typecheck && npm run typecheck:e2e",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:report": "playwright show-report",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  },
  "overrides": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3"
  }
}
